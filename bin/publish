#!/usr/bin/env bash
#
# Publish distribution archives to PyPI.
# Requires TWINE_USERNAME="__token__" and TWINE_PASSWORD="<your-pypi-token>"
# or prompts for credentials interactively.
#

set -euo pipefail

source "$(dirname "$0")/_common.sh"

cd "${PROJECT_ROOT}"

if [ ! -d "dist" ] || [ -z "$(ls -A dist/*.whl 2>/dev/null)" ]; then
    echo "No distribution files found in dist/. Running bin/build first..."
    "${SCRIPT_DIR}/build"
fi

echo "Validating packages prior to upload..."
python -m twine check dist/*

echo ""
echo "Uploading packages to PyPI..."
python -m twine upload dist/*

echo "Successfully published to PyPI!"
