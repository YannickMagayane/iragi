include README.md
include LICENSE
include pyproject.toml
include CHANGELOG.md
include bench_suite.py
include benchmarks/results.json
include benchmarks/benchmark.svg

recursive-include examples *.ipynb

recursive-include iragi *.py

# Exclude private, virtualenv and local files
global-exclude *.py[cod] __pycache__ *.so
prune .env
prune bin
prune docs
prune tests
prune dist
prune build
